# Walmart Marketplace API (Seller Center -> Settings -> API Key Management)
WALMART_CLIENT_ID=your-client-id
WALMART_CLIENT_SECRET=your-client-secret
# sandbox | production
WALMART_ENV=sandbox

# Restock math: days until new units are sellable at Walmart, and days each restock should cover
LEAD_TIME_DAYS=21
COVER_DAYS=30

# Your return address, required when creating inbound shipments
RETURN_ADDRESS_LINE1=
RETURN_CITY=
RETURN_STATE=
RETURN_POSTAL_CODE=

# Inbound shipments are logged but not created until this is false
DRY_RUN=true
